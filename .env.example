# Zoro environment variables. Copy to .env at the repository root for local development; every package reads it.
# Every value is optional locally: without keys Zoro still protects you, and each missing dependency is shown in the
# Console as "not configured" or "degraded". On Render, set these on the backend service (see render.yaml); on
# Vercel, only ZORO_DAEMON_URL is needed. Never commit real values.

# ============================================================================================================
# Backend (Backend/daemon)
# ============================================================================================================

# --- Server ---
ZORO_PORT=7420                  # Port to listen on. Hosting platforms set PORT instead; leave this unset there.
ZORO_HOST=127.0.0.1             # Interface to bind. 0.0.0.0 on a hosted server, 127.0.0.1 on your own machine.
# ZORO_DATA_DIR=                # Database, generated keys and tokens. Default: %LOCALAPPDATA%\Zoro (Windows), ~/Library/Application Support/Zoro (macOS), ~/.local/share/zoro (Linux).
# ZORO_EPHEMERAL_STORAGE=false  # true when the data directory is wiped on restart (Render free); shown as a degraded dependency.

# --- Web app and access ---
ZORO_WEB_ORIGIN=http://localhost:3000   # Origin of the web app; used for Console links and allowed for cross-origin API calls.
ZORO_PUBLIC_URL=http://localhost:3000   # Public URL of the web app, used in badges and shareable verification links.
# ZORO_CORS_ORIGINS=            # Extra browser origins allowed to call the API, comma-separated; `*` matches one hostname segment.
# ZORO_CONSOLE_TOKEN=           # Fixed Console sign-in token. If unset, one is generated in the data directory.
# ZORO_GATEWAY_TOKEN=           # Fixed token MCP clients use on /mcp. If unset, one is generated in the data directory.
# ZORO_ALLOWED_HOSTS=           # Public hostnames accepted on /mcp, comma-separated. RENDER_EXTERNAL_HOSTNAME is added automatically.

# --- Gateway behavior ---
# ZORO_REFRESH_INTERVAL_SEC=60      # How often upstream definitions are re-read.
# ZORO_APPROVAL_WAIT_SEC=45         # How long a paused call waits for an approval before the agent gets a pending refusal.
# ZORO_APPROVAL_WINDOW_SEC=900      # How long an approval request stays open.
# ZORO_ANCHOR_INTERVAL_SEC=900      # How often audit-log commitments are anchored to the organization topic.
# ZORO_MAX_DEFINITION_BYTES=65536   # Largest accepted tool definition; larger ones are quarantined as suspicious.
# ZORO_ORG_NAME=                    # Organization name shown in reports.
# ZORO_TRUSTED_AUDITORS=            # Extra auditor addresses whose ledger messages this gateway trusts, comma-separated.
# ZORO_ORG_SECRET=                  # Signs organization invites and member device tokens. Default: derived from the auditor key. Changing it signs every member out.

# --- Sentinel AI layer and Ask Zoro (Groq's free tier by default; any OpenAI-compatible API works) ---
GROQ_API_KEY=                   # API key from https://console.groq.com (free).
# AI_API_KEY=                   # Alternative to GROQ_API_KEY for another OpenAI-compatible provider.
# AI_BASE_URL=https://api.groq.com/openai/v1   # Base URL of the OpenAI-compatible API.
SENTINEL_MODEL=openai/gpt-oss-120b      # Model for Sentinel's semantic review.
ASK_MODEL=openai/gpt-oss-120b           # Model for Ask Zoro answers.
ASK_GUARD_MODEL=openai/gpt-oss-20b      # Model that first checks a question is about Zoro.
SENTINEL_REQUIRE_AI=true                # false = development mode: seals record that the AI layer did not run.
SENTINEL_SEAL_LIFETIME_DAYS=28          # Seal lifetime before a version is re-audited.
# SENTINEL_DUAL_REVIEW=true             # Require two independent AI review configurations to agree for high-impact tools.

# --- Auditor identity ---
ZORO_AUDITOR_PRIVATE_KEY=       # 0x-prefixed secp256k1 key that signs attestations and holds the ENS Auditor role. Generated locally if empty; must be fixed when hosted.

# --- ENSv2 registry (Ethereum Sepolia) ---
ENS_NETWORK=sepolia             # sepolia or mainnet.
ENS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com   # Ethereum JSON-RPC endpoint for that network.
ZORO_ENS_ROOT=                  # The .eth name you own on ENSv2 Sepolia, e.g. zoro-registry.eth.
ENS_OPERATOR_PRIVATE_KEY=       # Key of the account that owns the root name (pays Sepolia gas for registry writes).
ZORO_ENS_RESOLVER=              # Root Permissioned Resolver address (written by pnpm setup:ens).
ZORO_ENS_REGISTRY=              # Root UserRegistry address (written by pnpm setup:ens).
ZORO_ENS_LAB_RESOLVER=          # Attack Lab namespace resolver (written by pnpm setup:ens).
# ENS_CACHE_TTL_SEC=600         # How long a verified registry read is cached.
# ZORO_PUBLISH_LAB=true         # Publish Attack Lab verdicts under the lab namespace.
# ENSV2_ETH_REGISTRY=           # Override ENSv2 Sepolia contract addresses (defaults are built in).
# ENSV2_VERIFIABLE_FACTORY=
# ENSV2_PERMISSIONED_RESOLVER_IMPL=
# ENSV2_USER_REGISTRY_IMPL=

# --- Hedera ledger ---
HEDERA_NETWORK=testnet          # testnet, previewnet or mainnet.
HEDERA_OPERATOR_ID=             # Account ID that pays for ledger writes, e.g. 0.0.1234567.
HEDERA_OPERATOR_KEY=            # That account's private key (hex or DER).
# HEDERA_KEY_TYPE=auto          # auto, ecdsa, ed25519 or der.
HEDERA_REGISTRY_TOPIC_ID=       # Public registry topic (written by pnpm setup:hedera).
HEDERA_LAB_TOPIC_ID=            # Attack Lab topic (written by pnpm setup:hedera).
HEDERA_ORG_TOPIC_ID=            # Organization commitments topic (written by pnpm setup:hedera).
HEDERA_BADGE_TOKEN_ID=          # Seal badge NFT token (written by pnpm setup:hedera).
# HEDERA_MIRROR_URL=            # Mirror Node base URL; defaults to the public one for HEDERA_NETWORK.
# HEDERA_POLL_SEC=8             # How often the ledger is polled for new verdicts and revocations.

# --- World ID (Human Seal) ---
WORLD_APP_ID=                   # App ID from https://developer.world.org.
WORLD_RP_ID=                    # Relying-party ID from the same app.
WORLD_SIGNING_KEY=              # RP signing key from the same app (server-side only).
WORLD_ENVIRONMENT=staging       # staging = test identities (World ID Simulator); production = real verification.
# WORLD_VERIFY_BASE=https://developer.world.org   # World's verification API base URL.
# WORLD_APPROVAL_TTL_SEC=300    # Longest a Human Seal request stays valid.

# ============================================================================================================
# Web app (Frontend) — set in Vercel; read at build time for the API rewrites
# ============================================================================================================
# ZORO_DAEMON_URL=              # Backend base URL, e.g. https://zoro-backend.onrender.com. Default: http://127.0.0.1:7420.
