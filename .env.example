# Copy to .env. Every value is optional: without keys Zoro still protects you locally,
# and each missing dependency is shown in the Console as a degraded or "not configured" state.

# --- Daemon ---
ZORO_PORT=7420
ZORO_HOST=127.0.0.1
ZORO_WEB_ORIGIN=http://localhost:3000
ZORO_PUBLIC_URL=http://localhost:3000
# ZORO_DATA_DIR=            # default: %LOCALAPPDATA%\Zoro (Windows), ~/Library/Application Support/Zoro (macOS), ~/.local/share/zoro (Linux)

# --- Sentinel AI layer and Ask Zoro (Groq free tier; any OpenAI-compatible API works) ---
GROQ_API_KEY=               # free key from https://console.groq.com
# AI_BASE_URL=https://api.groq.com/openai/v1
SENTINEL_MODEL=openai/gpt-oss-120b
ASK_MODEL=openai/gpt-oss-120b
ASK_GUARD_MODEL=openai/gpt-oss-20b   # decides whether a question is about Zoro before anything else runs
SENTINEL_REQUIRE_AI=true    # false = development mode: seals record that the AI layer did not run
SENTINEL_SEAL_LIFETIME_DAYS=28

# --- Auditor key (attestations + ENS Auditor role). Generated in the data directory if empty. ---
ZORO_AUDITOR_PRIVATE_KEY=

# --- ENSv2 registry (Sepolia) ---
ENS_NETWORK=sepolia
ENS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ZORO_ENS_ROOT=              # a .eth name you own on ENSv2 Sepolia
ENS_OPERATOR_PRIVATE_KEY=   # owner of the root name
ZORO_ENS_RESOLVER=          # root Permissioned Resolver address
ZORO_ENS_REGISTRY=          # root UserRegistry address
ZORO_ENS_LAB_RESOLVER=      # Attack Lab namespace resolver (written by pnpm setup:ens)

# --- Hedera ledger ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_REGISTRY_TOPIC_ID=
HEDERA_LAB_TOPIC_ID=
HEDERA_ORG_TOPIC_ID=
HEDERA_BADGE_TOKEN_ID=

# --- World ID (Human Seal) ---
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
WORLD_ENVIRONMENT=staging   # staging = test identities (World ID Simulator)

# --- Hosted deployment ---
# ZORO_CONSOLE_TOKEN=        # fixed Console token; otherwise one is generated in the data directory
# ZORO_GATEWAY_TOKEN=        # fixed MCP gateway token
# ZORO_ALLOWED_HOSTS=        # public host(s) accepted on /mcp, e.g. api.example.com
# Web app (set in your hosting provider, read at build time):
# ZORO_DAEMON_URL=           # e.g. https://api.example.com
